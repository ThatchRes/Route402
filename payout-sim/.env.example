PORT=8403
# Shared with Person A's backend (and the CLI) for internal calls
PAYOUT_INTERNAL_TOKEN=change-me
# HMAC secret the simulated provider signs its webhooks with (a real provider gives you this)
PROVIDER_WEBHOOK_SECRET=change-me-too
# x402 seller (to verify FUNDING_CONFIRMED before any payout)
SELLER_URL=http://localhost:8402
X402_INTERNAL_TOKEN=same-value-as-x402-spike-.env
# Speed of simulated provider events (ms between events)
SIM_EVENT_DELAY_MS=1500

# Where the x402-spike folder is (for `npm run transfer`)
X402_DIR=../x402-spike
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Router (route optimizer + orchestration) - `npm run router`
ROUTER_PORT=8404
# Must equal AGENT_SERVICE_TOKEN in services/agents/.env (agents call the router with it)
ROUTER_TOKEN=change-me-router
PAYOUT_URL=http://localhost:8403
TREASURY_USD=2000000.00

# Capital One Nessie sandbox (hackathon). Key from the Nessie portal.
NESSIE_API_KEY=
NESSIE_BASE_URL=https://api.nessieisreal.com
