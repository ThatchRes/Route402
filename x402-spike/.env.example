# From portal.cdp.coinbase.com -> API Keys (secret API key) and Wallet Secret. Never commit .env.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=
# Address that RECEIVES the test payment (your seller). Run `npm run address` to print the buyer's address.
X402_PAY_TO=0x...
SELLER_URL=http://localhost:8402
# Shared secret between Person A's backend and this seller's internal /orders API
X402_INTERNAL_TOKEN=change-me
# Hard caps (USDC). Each stablecoin transfer pays exactly 0.01 via x402; total spend can never exceed the cap (0.25 = 25 transfers).
PER_PAYMENT_USDC=0.01
TOTAL_SPEND_CAP_USDC=0.25
REQUIRED_CONFIRMATIONS=3
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Pay-per-call services the agents buy with x402 (quotes, beneficiary screening) and their wallet
CALL_PRICE_USDC=0.001
AGENT_CALL_CAP_USDC=0.25
AGENT_WALLET_PORT=8405
# The seller's paid quote/screen endpoints are backed by the router: same ROUTER_TOKEN as payout-sim/.env
ROUTER_URL=http://localhost:8404
ROUTER_TOKEN=
