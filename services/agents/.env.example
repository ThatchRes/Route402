# Seeds = agent identities. Long random strings. Keep the same values so addresses stay stable.
ROUTING_SEED=change-me-routing-long-random
INVESTIGATION_SEED=change-me-investigation-long-random
GATEWAY_SEED=change-me-gateway-long-random
LIQUIDITY_SEED=change-me-liquidity-long-random
EXECUTOR_SEED=change-me-executor-long-random
RECONCILIATION_SEED=change-me-reconciliation-long-random
# Shared secret with Person A's backend (you generate it)
AGENT_SERVICE_TOKEN=change-me-shared-with-person-a
ALLOWED_TENANTS=demo-tenant
API_BASE_URL=http://localhost:4000
MOCK_API=1
GATEWAY_PORT=8100
WORKERS_PORT=8101
RATE_LIMIT_PER_MIN=120
# Optional LLM (intent parsing, explanations, summaries). Leave blank for labeled deterministic fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Optional: Fetch.ai chat protocol + Agentverse mailbox on the gateway (check track rules first)
ENABLE_CHAT=0
CHAT_TENANT=demo-tenant
