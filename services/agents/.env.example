# Seeds = agent identities. Long random strings. Keep the same values so addresses stay stable.
ROUTING_SEED=change-me-routing-long-random
INVESTIGATION_SEED=change-me-investigation-long-random
GATEWAY_SEED=change-me-gateway-long-random
LIQUIDITY_SEED=change-me-liquidity-long-random
EXECUTOR_SEED=change-me-executor-long-random
RECONCILIATION_SEED=change-me-reconciliation-long-random
# Shared secret with Person A's backend (you generate it)
AGENT_SERVICE_TOKEN=change-me-shared-with-person-a
ALLOWED_TENANTS=demo-tenant
# Point at the router (payout-sim `npm run router`) and set MOCK_API=0 to use real routing data
API_BASE_URL=http://localhost:8404
MOCK_API=1
# Optional: point investigation/reconciliation at the payout service (works even with MOCK_API=1)
EVIDENCE_API_BASE_URL=
EVIDENCE_API_TOKEN=
GATEWAY_PORT=8100
WORKERS_PORT=8101
RATE_LIMIT_PER_MIN=120
# Optional LLM (intent parsing, explanations, summaries). Leave blank for labeled deterministic fallback.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Fetch.ai chat protocol + Agentverse mailbox on the concierge (gateway), so ASI:One can reach it
ENABLE_CHAT=1
CHAT_TENANT=demo-tenant
CHAT_PAID_PER_MIN=3
AGENT_NAME=Cross-Border AP Concierge
# agentverse.ai -> profile -> API Keys; used once by `python register_agentverse.py`
AGENTVERSE_API_KEY=
# Agent wallet (x402-spike `npm run wallet`): agents buy quotes and supplier screens per call. Same token as x402-spike/.env
AGENT_WALLET_URL=http://localhost:8405
X402_INTERNAL_TOKEN=
# Routing policy: hold any payment costing more than this above the mid rate (basis points)
ROUTING_MAX_COST_BPS=150
# LOCAL_ROUTING=1        # local router quotes and validation, no wallet, seller or x402 payments
